import io
import time

from PIL import Image

import rclpy
from rclpy.node import Node
from rclpy.qos import (
    QoSProfile,
    QoSReliabilityPolicy,
    QoSHistoryPolicy,
    QoSDurabilityPolicy,
)
from sensor_msgs.msg import CompressedImage

from rtdetr_ros.trt_backend import (
    TRTModel,
    preprocess,
    postprocess,
    draw_detections,
)


class RTDETRInferenceNode(Node):

    def __init__(self):
        super().__init__("rtdetr_inference")

        self.declare_parameter(
            "engine_path",
            "/models/rtdetr_B512_epoch054_fp16.engine",
        )

        self.declare_parameter(
            "threshold",
            0.5,
        )

        engine_path = (
            self.get_parameter("engine_path")
            .get_parameter_value()
            .string_value
        )

        self.threshold = (
            self.get_parameter("threshold")
            .get_parameter_value()
            .double_value
        )

        qos = QoSProfile(
            history=QoSHistoryPolicy.KEEP_LAST,
            depth=1,
            reliability=QoSReliabilityPolicy.BEST_EFFORT,
            durability=QoSDurabilityPolicy.VOLATILE,
        )

        self.publisher = self.create_publisher(
            CompressedImage,
            "/rtdetr/annotated_image/compressed",
            qos,
        )

        self.subscription = self.create_subscription(
            CompressedImage,
            "/camera/image/compressed",
            self.image_callback,
            qos,
        )

        self.get_logger().info(
            f"Loading TensorRT engine: {engine_path}"
        )

        self.model = TRTModel(engine_path)

        self.frame_count = 0

        self.get_logger().info(
            "RT-DETR inference node ready"
        )

        self.get_logger().info(
            f"Threshold: {self.threshold:.2f}"
        )

    def image_callback(self, msg):
        total_start = time.perf_counter()

        # --------------------------------------------------
        # JPEG decode
        # --------------------------------------------------

        decode_start = time.perf_counter()

        image = Image.open(
            io.BytesIO(msg.data)
        ).convert("RGB")

        decode_ms = (
            time.perf_counter() - decode_start
        ) * 1000.0

        # --------------------------------------------------
        # Preprocessing
        # --------------------------------------------------

        preprocess_start = time.perf_counter()

        tensor, original_size = preprocess(image)

        preprocess_ms = (
            time.perf_counter() - preprocess_start
        ) * 1000.0

        # --------------------------------------------------
        # TensorRT inference
        # --------------------------------------------------

        outputs, inference_ms = self.model.infer(
            tensor
        )

        # --------------------------------------------------
        # Postprocessing
        # --------------------------------------------------

        post_start = time.perf_counter()

        detections = postprocess(
            outputs["pred_logits"],
            outputs["pred_boxes"],
            original_size,
            self.threshold,
        )

        annotated = draw_detections(
            image.copy(),
            detections,
        )

        post_ms = (
            time.perf_counter() - post_start
        ) * 1000.0

        # --------------------------------------------------
        # JPEG encode
        # --------------------------------------------------

        encode_start = time.perf_counter()

        buffer = io.BytesIO()

        annotated.save(
            buffer,
            format="JPEG",
            quality=85,
        )

        encoded = buffer.getvalue()

        encode_ms = (
            time.perf_counter() - encode_start
        ) * 1000.0

        # --------------------------------------------------
        # Publish annotated image
        # --------------------------------------------------

        output_msg = CompressedImage()

        output_msg.header = msg.header
        output_msg.format = "jpeg"
        output_msg.data = encoded

        self.publisher.publish(output_msg)

        # --------------------------------------------------
        # Performance
        # --------------------------------------------------

        total_ms = (
            time.perf_counter() - total_start
        ) * 1000.0

        self.frame_count += 1

        if self.frame_count % 25 == 0:

            processing_fps = (
                1000.0 / total_ms
                if total_ms > 0
                else 0.0
            )

            self.get_logger().info(
                f"Frame {self.frame_count}: "
                f"detections={len(detections)}, "
                f"decode={decode_ms:.2f} ms, "
                f"pre={preprocess_ms:.2f} ms, "
                f"TRT={inference_ms:.2f} ms, "
                f"post={post_ms:.2f} ms, "
                f"encode={encode_ms:.2f} ms, "
                f"total={total_ms:.2f} ms, "
                f"capacity={processing_fps:.2f} FPS"
            )

    def destroy_node(self):
        if hasattr(self, "model"):
            self.model.close()

        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)

    node = RTDETRInferenceNode()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
