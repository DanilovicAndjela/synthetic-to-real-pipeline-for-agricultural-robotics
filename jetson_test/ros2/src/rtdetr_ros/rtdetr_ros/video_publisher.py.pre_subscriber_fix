import time

import cv2

import rclpy
from rclpy.node import Node
from rclpy.qos import (
    QoSProfile,
    QoSReliabilityPolicy,
    QoSHistoryPolicy,
    QoSDurabilityPolicy,
)

from sensor_msgs.msg import CompressedImage


TARGET_WIDTH = 960
TARGET_HEIGHT = 544
JPEG_QUALITY = 85


class VideoPublisher(Node):

    def __init__(self):
        super().__init__("video_publisher")

        self.declare_parameter(
            "video_path",
            "/input/sugarbeets_test_5fps.mp4",
        )

        self.declare_parameter(
            "benchmark_mode",
            False,
        )

        self.declare_parameter(
            "benchmark_period_ms",
            1.0,
        )

        video_path = (
            self.get_parameter("video_path")
            .get_parameter_value()
            .string_value
        )

        self.benchmark_mode = (
            self.get_parameter("benchmark_mode")
            .get_parameter_value()
            .bool_value
        )

        benchmark_period_ms = (
            self.get_parameter("benchmark_period_ms")
            .get_parameter_value()
            .double_value
        )

        self.cap = cv2.VideoCapture(video_path)

        if not self.cap.isOpened():
            raise RuntimeError(
                f"Could not open video: {video_path}"
            )

        source_width = int(
            self.cap.get(cv2.CAP_PROP_FRAME_WIDTH)
        )
        source_height = int(
            self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT)
        )
        self.source_frame_count = int(
            self.cap.get(cv2.CAP_PROP_FRAME_COUNT)
        )

        self.source_fps = self.cap.get(
            cv2.CAP_PROP_FPS
        )

        if self.source_fps <= 0:
            self.source_fps = 5.0

        qos = QoSProfile(
            history=QoSHistoryPolicy.KEEP_LAST,
            depth=1,
            reliability=QoSReliabilityPolicy.BEST_EFFORT,
            durability=QoSDurabilityPolicy.VOLATILE,
        )

        self.publisher = self.create_publisher(
            CompressedImage,
            "/camera/image/compressed",
            qos,
        )

        if self.benchmark_mode:
            timer_period = (
                benchmark_period_ms / 1000.0
            )
        else:
            timer_period = (
                1.0 / self.source_fps
            )

        self.timer = self.create_timer(
            timer_period,
            self.publish_frame,
        )

        self.frame_id = 0
        self.start_time = None
        self.finished = False

        self.get_logger().info(
            f"Video opened: {video_path}"
        )

        self.get_logger().info(
            f"Source: {source_width}x{source_height}, "
            f"frames={self.source_frame_count}, "
            f"source FPS={self.source_fps:.2f}"
        )

        self.get_logger().info(
            f"ROS JPEG output: "
            f"{TARGET_WIDTH}x{TARGET_HEIGHT}, "
            f"quality={JPEG_QUALITY}"
        )

        self.get_logger().info(
            f"Benchmark mode: {self.benchmark_mode}"
        )

        if self.benchmark_mode:
            self.get_logger().info(
                f"Benchmark timer period: "
                f"{benchmark_period_ms:.3f} ms"
            )

    def publish_frame(self):

        if self.finished:
            return

        ok, frame = self.cap.read()

        if not ok:
            self.finished = True
            self.timer.cancel()

            elapsed = (
                time.monotonic() - self.start_time
                if self.start_time is not None
                else 0.0
            )

            actual_fps = (
                self.frame_id / elapsed
                if elapsed > 0
                else 0.0
            )

            self.get_logger().info(
                "===== PUBLISHER FINISHED ====="
            )
            self.get_logger().info(
                f"Published frames: {self.frame_id}"
            )
            self.get_logger().info(
                f"Publisher throughput: "
                f"{actual_fps:.2f} FPS"
            )
            self.get_logger().info(
                "=============================="
            )

            return

        if self.start_time is None:
            self.start_time = time.monotonic()

        frame = cv2.resize(
            frame,
            (TARGET_WIDTH, TARGET_HEIGHT),
            interpolation=cv2.INTER_LINEAR,
        )

        ok, encoded = cv2.imencode(
            ".jpg",
            frame,
            [
                cv2.IMWRITE_JPEG_QUALITY,
                JPEG_QUALITY,
            ],
        )

        if not ok:
            self.get_logger().error(
                "JPEG encoding failed"
            )
            return

        msg = CompressedImage()

        msg.header.stamp = (
            self.get_clock().now().to_msg()
        )

        # Sequence number used to detect dropped frames.
        msg.header.frame_id = str(self.frame_id)

        msg.format = "jpeg"
        msg.data = encoded.tobytes()

        self.publisher.publish(msg)

        self.frame_id += 1

        if self.frame_id % 50 == 0:

            elapsed = (
                time.monotonic()
                - self.start_time
            )

            actual_fps = (
                self.frame_id / elapsed
            )

            self.get_logger().info(
                f"Published "
                f"{self.frame_id} frames "
                f"({actual_fps:.2f} FPS), "
                f"JPEG size="
                f"{len(msg.data)/1024:.1f} KB"
            )

    def destroy_node(self):
        self.cap.release()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)

    node = VideoPublisher()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
