    }

    def Scope "_materials"
    {
        def Material "grass_medium_02"
        {
            token outputs:surface.connect = </root/_materials/grass_medium_02/PBRShader.outputs:surface>
            custom string userProperties:blender:data_name = "grass_medium_02"

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/_materials/grass_medium_02/diffuseTex.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/grass_medium_02/normalTex.outputs:rgb>
                float inputs:opacity.connect = </root/_materials/grass_medium_02/opacityTex.outputs:r>
                float inputs:opacityThreshold = 0.35
                float inputs:roughness = 0.8
                float inputs:roughness.connect = </root/_materials/grass_medium_02/roughTex.outputs:r>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "UVMap"
                float2 outputs:result
            }

            def Shader "diffuseTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/grass_medium_02_diff_4k.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/grass_medium_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "opacityTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/grass_medium_02_alpha_4k.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/grass_medium_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "roughTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/grass_medium_02_rough_4k.exr@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/grass_medium_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "normalTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/grass_medium_02_nor_gl_4k.exr@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/grass_medium_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }
    }
}

