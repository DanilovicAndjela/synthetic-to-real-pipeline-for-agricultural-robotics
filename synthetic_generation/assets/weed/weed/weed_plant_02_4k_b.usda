                float2 inputs:st.connect = </root/_materials/weed_plant_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "roughTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/weed_plant_02_rough_4k.exr@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/weed_plant_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "normalTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/weed_plant_02_nor_gl_4k.exr@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/weed_plant_02/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }
    }
}

