    def Scope "_materials"
    {
        def Material "dandelion_01"
        {
            token outputs:surface.connect = </root/_materials/dandelion_01/PBRShader.outputs:surface>
            custom string userProperties:blender:data_name = "dandelion_01"

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/_materials/dandelion_01/diffuseTex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:opacity.connect = </root/_materials/dandelion_01/opacityTex.outputs:r>
                float inputs:opacityThreshold = 0.35
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "UVMap"
                float2 outputs:result
            }

            def Shader "diffuseTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/dandelion_01_diff_4k.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/dandelion_01/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "opacityTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/dandelion_01_alpha_4k.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/dandelion_01/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }
    }
}

